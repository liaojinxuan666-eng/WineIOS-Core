diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index d4c109b..7206240 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -826,6 +826,15 @@ void init_environment(void)
     USHORT *case_table;

     init_unix_codepage();
+#if defined(__APPLE__) && defined(__MACH__)
+    /*
+     * Device bring-up probe: stop after the first real environment
+     * initialization slice so iOS failures can be localized without
+     * changing normal Wine behavior when WIOS_ENV_PROBE is unset.
+     */
+    if (getenv( "WIOS_ENV_PROBE" ) &&
+        !strcmp( getenv( "WIOS_ENV_PROBE" ), "codepage" )) return;
+#endif
     init_locale();

     if ((case_table = read_nls_file( "l_intl.nls" )))
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index d081bfd..75e9a2b 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -193,6 +193,16 @@ const char **system_dll_paths = NULL;
 const char *user_name = NULL;
 SECTION_IMAGE_INFORMATION main_image_info = { NULL };

+#if defined(__APPLE__) && defined(__MACH__)
+static unsigned int wios_main_probe_stop_stage;
+
+__attribute__((visibility("default")))
+void wios_ntdll_set_main_probe_stop_stage( unsigned int stage )
+{
+    wios_main_probe_stop_stage = stage;
+}
+#endif
+
 /* die on a fatal error; use only during initialization */
 static void fatal_error( const char *err, ... )
 {
@@ -2281,6 +2291,11 @@ DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
     main_argv = argv;

     init_paths();
+#if defined(__APPLE__) && defined(__MACH__)
+    /* Stage 1 proves the real __wine_main entry and path setup. */
+    if (wios_main_probe_stop_stage == 1) return;
+#endif
+
     if (!getenv( "WINELOADERNOEXEC" ) || argc <= 1) check_command_line( argc, argv );
     unsetenv( "WINELOADERNOEXEC" );

@@ -2297,3 +2312,13 @@ DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
     virtual_init();
+#if defined(__APPLE__) && defined(__MACH__)
+    /* Stage 2 proves Wine virtual address-space initialization. */
+    if (wios_main_probe_stop_stage == 2) return;
+#endif
+
     init_environment();
+#if defined(__APPLE__) && defined(__MACH__)
+    /* Stage 3 returns after the selected environment probe slice. */
+    if (wios_main_probe_stop_stage == 3) return;
+#endif
+

