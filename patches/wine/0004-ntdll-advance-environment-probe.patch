--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -13,10 +13,27 @@ void init_environment(void)
         !strcmp( getenv( "WIOS_ENV_PROBE" ), "codepage" )) return;
