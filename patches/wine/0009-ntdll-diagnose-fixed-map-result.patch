+__attribute__((visibility("default")))
+NTSTATUS wios_ntdll_probe_host_vm(void)
+{
+    TEB *teb = pthread_getspecific( teb_key );
+    MEMORY_BASIC_INFORMATION info;
+    void *base = NULL, *region;
+    SIZE_T size, returned;
+    ULONG old_protect;
+    NTSTATUS status = STATUS_UNSUCCESSFUL;
+
+    wios_host_vm_release_status = STATUS_SUCCESS;
+    wios_host_vm_stage = "TEB_TLS";
+    if (!teb || NtCurrentTeb() != teb || teb->Tib.Self != &teb->Tib || teb->Peb != peb)
+        return status;
+
+    wios_host_vm_stage = "RESERVE";
+    size = 2 * host_page_size;
+    if ((status = NtAllocateVirtualMemory( NtCurrentProcess(), &base, 0, &size,
+                                          MEM_RESERVE, PAGE_READWRITE ))) return status;
+    wios_host_vm_stage = "COMMIT";
+    region = base;
+    size = host_page_size;
+    if ((status = NtAllocateVirtualMemory( NtCurrentProcess(), &region, 0, &size,
+                                          MEM_COMMIT, PAGE_READWRITE ))) goto release;
+    wios_host_vm_stage = "WRITE";
+    ((volatile unsigned char *)base)[0] = 0x5a;
+    ((volatile unsigned char *)base)[host_page_size - 1] = 0xa5;
+
+    wios_host_vm_stage = "PROTECT_RO";
+    region = base;
+    size = host_page_size;
+    if ((status = NtProtectVirtualMemory( NtCurrentProcess(), &region, &size,
+                                         PAGE_READONLY, &old_protect ))) goto release;
+    wios_host_vm_stage = "QUERY";
+    returned = 0;
+    if ((status = NtQueryVirtualMemory( NtCurrentProcess(), base, MemoryBasicInformation,
+                                       &info, sizeof(info), &returned ))) goto release;
+    if (returned != sizeof(info) || info.State != MEM_COMMIT || info.Protect != PAGE_READONLY ||
+        info.AllocationBase != base || info.RegionSize < host_page_size)
+    {
+        status = STATUS_UNSUCCESSFUL;
+        goto release;
+    }
+    wios_host_vm_stage = "READ_RO";
+    if (((volatile unsigned char *)base)[0] != 0x5a ||
+        ((volatile unsigned char *)base)[host_page_size - 1] != 0xa5)
+    {
+        status = STATUS_UNSUCCESSFUL;
+        goto release;
+    }
+    wios_host_vm_stage = "PROTECT_RW";
+    region = base;
+    size = host_page_size;
+    if ((status = NtProtectVirtualMemory( NtCurrentProcess(), &region, &size,
+                                         PAGE_READWRITE, &old_protect ))) goto release;
+    ((volatile unsigned char *)base)[0] = 0xc3;
+    if (((volatile unsigned char *)base)[0] != 0xc3)
+    {
+        status = STATUS_UNSUCCESSFUL;
+        goto release;
+    }
+    wios_host_vm_stage = "RELEASE";
+release:
+    region = base;
+    size = 0;
+    wios_host_vm_release_status = NtFreeVirtualMemory( NtCurrentProcess(), &region, &size, MEM_RELEASE );
+    if (!status)
+    {
+        status = wios_host_vm_release_status;
+        if (!status) wios_host_vm_stage = "PASS";
+    }
+    return status;
+}
